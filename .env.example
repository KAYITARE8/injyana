# Copy this file to .env and fill it in. NEVER commit .env.
PORT=3000
DATABASE_URL=postgres://injyana:injyana@localhost:5432/injyana
JWT_SECRET=change-me-to-a-long-random-string
AUDIUS_API_KEY=your-audius-api-key
# Set to true when served over HTTPS (Render, etc.)
COOKIE_SECURE=false
# Max upload size in MB
MAX_UPLOAD_MB=50
# Optional Cloudflare R2 storage for uploaded audio. Local disk is used by default.
# UPLOAD_STORAGE=r2
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
